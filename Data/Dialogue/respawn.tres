[gd_resource type="Resource" script_class="dialogue_sequence" format=3 uid="uid://w225xts1wder"]

[ext_resource type="Script" uid="uid://c08iw1y3tl01g" path="res://Scripts/Dialogue/dialogue_line.gd" id="line"]
[ext_resource type="Script" uid="uid://chxo6i74ojp1q" path="res://Scripts/Dialogue/dialogue_sequence.gd" id="sequence"]
[ext_resource type="AudioStream" uid="uid://b37bfd5jo0pu2" path="res://Audio/Vocals/vo__I (first death).wav" id="voice1"]
[ext_resource type="AudioStream" uid="uid://cf27k7ot1o8ss" path="res://Audio/Vocals/vo__I thought I died.wav" id="voice2"]

[sub_resource type="Resource" id="First"]
