; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Remnant"
run/main_scene="res://Scenes/UI/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Blackboard="*uid://b0xpvnyknnyk0"
Flags="*uid://cmu2qskbjdauq"
SceneManager="*uid://b0kybwgisrflw"
Audio="*uid://6htl8d4x7ugw"
ScoreRewards="*res://Global/score_rewards.gd"
GrindCombo="*res://Global/grind_combo.gd"
Progression="*res://Global/progression.gd"
WorldState="*res://Global/world_state.gd"
Notes="*res://Global/notes.gd"
Dialogue="*res://Global/dialogue.gd"
SaveGame="*res://Global/save_game.gd"
Settings="*res://Global/settings.gd"
Mulch="*res://Global/mulch.gd"
DevTools="*res://Global/dev_tools.gd"
IssueReporter="*res://Global/issue_reporter.gd"
DebugInspector="*res://Global/debug_inspector.gd"
DevConsole="*res://Global/dev_console.gd"
GameplayRecorder="*res://Global/gameplay_recorder.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file="C:/Users/callm/Videos/atmosphere.avi"

[global_group]

Chute="the group for the chute objects"
interact=""
pick-up=""
building="Placed buildings that can be packed with Q"
look-prompt="Objects with configurable look-at prompts"
score="Items that award points when destroyed by a grinding area"
grindable="Item wrapper roots destroyed together with their rigid-body children"
lever="Manual chute levers"
build-socket="Compatible machine attachment and conveyor connection markers"
machine-immune="Reusable tools and baskets excluded from grinding"

